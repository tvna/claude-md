{
  "name": "claude-md Claude prebuild",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/nix:1": {
      "extraNixConfig": "experimental-features = nix-command flakes\naccept-flake-config = true"
    },
    "../features/agent-user": {
      "agentUser": "claude"
    }
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/nix",
    "../features/agent-user"
  ],
  "remoteEnv": {
    "AGENT_CONTAINER": "claude"
  },
  "postCreateCommand": "bash .devcontainer/scripts/install-agent-cli.sh claude && bash .devcontainer/scripts/configure-agent-runtime.sh claude",
  "customizations": {
    "vscode": {
      "extensions": [
        "jnoortheen.nix-ide",
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}

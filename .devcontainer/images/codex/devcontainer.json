{
  "name": "claude-md Codex prebuild",
  "image": "ubuntu:24.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "installOhMyZsh": false,
      "installOhMyZshConfig": false,
      "upgradePackages": false,
      "username": "none"
    },
    "ghcr.io/devcontainers/features/nix:1": {
      "extraNixConfig": "experimental-features = nix-command flakes\naccept-flake-config = true"
    },
    "../features/agent-user": {
      "agentUser": "codex"
    }
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/common-utils",
    "ghcr.io/devcontainers/features/nix",
    "../features/agent-user"
  ],
  "remoteEnv": {
    "AGENT_CONTAINER": "codex"
  },
  "postCreateCommand": "bash .devcontainer/scripts/install-agent-cli.sh codex && bash .devcontainer/scripts/configure-agent-runtime.sh codex",
  "customizations": {
    "vscode": {
      "extensions": [
        "jnoortheen.nix-ide",
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}

{
  "folders": [
    {
      "name": "claude-md",
      "path": "."
    }
  ],
  "settings": {
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.readonlyInclude": {
      "CLAUDE.md": true,
      "AGENTS.md": true
    },
    "files.exclude": {
      "**/__pycache__": true,
      "**/.venv": true,
      "**/apm_modules": true
    },
    "search.exclude": {
      "CLAUDE.md": true,
      "AGENTS.md": true,
      "uv.lock": true,
      "**/.venv": true,
      "**/apm_modules": true
    },
    "[markdown]": {
      "editor.wordWrap": "on",
      "editor.tabSize": 2,
      "editor.formatOnSave": false
    },
    "[yaml]": {
      "editor.tabSize": 2,
      "editor.insertSpaces": true
    },
    "[json]": {
      "editor.tabSize": 2
    },
    "[jsonc]": {
      "editor.tabSize": 2
    },
    "yaml.schemas": {
      "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
    },
    "dev.containers.dockerPath": "podman",
    "terminal.integrated.env.osx": {
      "PATH": "${env:HOME}/.uv-pins/claude-md:/opt/podman/bin:${env:PATH}"
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "ruff.nativeServer": "on",
    "ruff.importStrategy": "useBundled",
    "ruff.configuration": "${workspaceFolder}/pyproject.toml"
  },
  "extensions": {
    "recommendations": [
      "DavidAnson.vscode-markdownlint",
      "yzhang.markdown-all-in-one",
      "redhat.vscode-yaml",
      "tamasfe.even-better-toml",
      "ms-python.python",
      "charliermarsh.ruff",
      "streetsidesoftware.code-spell-checker"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "bootstrap pinned uv",
        "detail": "Install the repo-pinned uv into ~/.uv-pins/claude-md so brew uv need not match the pin (#1205).",
        "type": "shell",
        "command": "${workspaceFolder}/scripts/setup_pinned_uv.sh",
        "runOptions": {
          "runOn": "folderOpen"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "silent",
          "panel": "shared"
        }
      },
      {
        "label": "apm: compile",
        "detail": "Compile instructions through the repo-pinned uv resolved from ~/.uv-pins/claude-md in macOS rescue terminals.",
        "type": "shell",
        "command": "uv run --with \"apm-cli==0.12.1\" apm compile",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "uv: sync (locked)",
        "detail": "Synchronize the locked project environment through the repo-pinned uv resolved from ~/.uv-pins/claude-md in macOS rescue terminals.",
        "type": "shell",
        "command": "uv sync --locked",
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      }
    ]
  }
}

{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/install-uv.sh",
            "statusMessage": "Checking uv pin"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/plan_language_context.py",
            "statusMessage": "Loading language policy"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/check_hooks_path.py",
            "statusMessage": "Checking git hooks path"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/check_pr_mergeability.py session-start",
            "statusMessage": "Checking open PR mergeability"
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
            "async": false
          }
        ],
        "_apm_source": "superpowers"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__github__(issue_write|add_issue_comment|create_pull_request|update_pull_request|add_reply_to_pull_request_comment|pull_request_review_write|add_comment_to_pending_review|sub_issue_write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/preflight_non_ascii.py",
            "statusMessage": "Checking GitHub text"
          }
        ]
      },
      {
        "matcher": "^mcp__github__issue_write$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/issue_closure_fast_path.py",
            "statusMessage": "Checking issue closure evidence"
          }
        ]
      },
      {
        "matcher": "^mcp__github__(issue_write|add_issue_comment|create_pull_request|update_pull_request|add_reply_to_pull_request_comment|pull_request_review_write|add_comment_to_pending_review)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/preflight_codex_github_footer.py",
            "statusMessage": "Checking Codex GitHub footer"
          }
        ]
      },
      {
        "matcher": "^mcp__github__create_branch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/preflight_main_freshness.py",
            "statusMessage": "Checking origin/main freshness"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/preflight_push_base.py",
            "statusMessage": "Checking branch base before push"
          }
        ]
      },
      {
        "matcher": "^mcp__github__(create_pull_request|update_pull_request)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/preflight_branch_base.py verify",
            "statusMessage": "Checking branch base"
          },
          {
            "type": "command",
            "command": "python3 scripts/pr_body_close_keyword_gate.py",
            "statusMessage": "Checking PR issue links"
          }
        ]
      },
      {
        "matcher": "^mcp__github__(issue_write|create_pull_request|update_pull_request)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/preflight_title_policy.py",
            "statusMessage": "Checking GitHub title"
          }
        ]
      },
      {
        "matcher": "^mcp__github__(create_pull_request|update_pull_request)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/preflight_pr_body_required_sections.py",
            "statusMessage": "Checking PR sections"
          }
        ]
      },
      {
        "matcher": "^mcp__github__(create_pull_request|update_pull_request)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/preflight_pr_template_shape.py",
            "statusMessage": "Checking PR template"
          }
        ]
      },
      {
        "matcher": "^mcp__codex_apps__github\\._(create_issue|create_pull_request|update_pull_request)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/preflight_non_ascii.py",
            "statusMessage": "Checking GitHub text"
          },
          {
            "type": "command",
            "command": "python3 scripts/preflight_codex_github_footer.py",
            "statusMessage": "Checking Codex GitHub footer"
          },
          {
            "type": "command",
            "command": "python3 scripts/preflight_title_policy.py",
            "statusMessage": "Checking GitHub title"
          }
        ]
      },
      {
        "matcher": "^mcp__codex_apps__github\\._(create_pull_request|update_pull_request)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/preflight_branch_base.py verify",
            "statusMessage": "Checking branch base"
          },
          {
            "type": "command",
            "command": "python3 scripts/pr_body_close_keyword_gate.py",
            "statusMessage": "Checking PR issue links"
          },
          {
            "type": "command",
            "command": "python3 scripts/preflight_pr_body_required_sections.py",
            "statusMessage": "Checking PR sections"
          },
          {
            "type": "command",
            "command": "python3 scripts/preflight_pr_template_shape.py",
            "statusMessage": "Checking PR template"
          }
        ]
      },
      {
        "matcher": "^mcp__github__",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/gate_mcp_github_uncovered.py",
            "statusMessage": "Checking GitHub MCP tool coverage"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__github__create_pull_request$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/post_pr_create_ci_monitor.py",
            "statusMessage": "Starting PR CI monitor"
          },
          {
            "type": "command",
            "command": "python3 scripts/ci_early_status_probe.py",
            "statusMessage": "Checking early CI status"
          },
          {
            "type": "command",
            "command": "python3 scripts/check_pr_mergeability.py",
            "statusMessage": "Checking PR mergeability"
          }
        ]
      },
      {
        "matcher": "^mcp__github__update_pull_request_branch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/check_pr_mergeability.py",
            "statusMessage": "Checking PR mergeability"
          }
        ]
      },
      {
        "matcher": "^mcp__codex_apps__github\\._create_pull_request$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/post_pr_create_ci_monitor.py",
            "statusMessage": "Starting PR CI monitor"
          },
          {
            "type": "command",
            "command": "python3 scripts/ci_early_status_probe.py",
            "statusMessage": "Checking early CI status"
          },
          {
            "type": "command",
            "command": "python3 scripts/check_pr_mergeability.py",
            "statusMessage": "Checking PR mergeability"
          }
        ]
      }
    ],
    "sessionStart": [
      {
        "command": "./hooks/run-hook.cmd session-start",
        "_apm_source": "superpowers"
      }
    ]
  }
}

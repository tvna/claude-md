{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/tmp/claude-plans/**)",
      "Write(/tmp/claude-plans/**)",
      "MultiEdit(/tmp/claude-plans/**)"
    ],
    "deny": [
      "Bash(git -c commit.gpgsign=false:*)",
      "Bash(git -c commit.gpgsign=0:*)",
      "Bash(git -c commit.gpgsign=no:*)",
      "Bash(git -c commit.gpgsign=off:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && scripts/install-uv.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && scripts/install-rtk.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && scripts/install-apm.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && scripts/install-actionlint.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && scripts/install-waza.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && scripts/install-ccusage.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && scripts/install-bun.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && scripts/install-zizmor.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && scripts/install-lychee.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && scripts/install-betterleaks.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && scripts/session_uv_local_pin.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && uv run python3 scripts/gen_mcp_json.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/plan_language_context.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/check_hooks_path.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/check_session_branch.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_session_base_freshness.py session-start"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/check_pr_mergeability.py session-start"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/check_commit_signing_ready.py session-start"
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
            "async": false
          }
        ],
        "_apm_source": "superpowers"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/prompt_context7_gate.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/block_sensitive_reads.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(issue_write|add_issue_comment|create_pull_request|update_pull_request|add_reply_to_pull_request_comment|pull_request_review_write|add_comment_to_pending_review|sub_issue_write|merge_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_non_ascii.py"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_github_secrets.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(issue_write|add_issue_comment|create_pull_request|update_pull_request|add_reply_to_pull_request_comment|pull_request_review_write|add_comment_to_pending_review|sub_issue_write)",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_angle_token_drop.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/issue_closure_fast_path.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_issue_close_comment.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_issue_classification_labels.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_reserved_retro_scope.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_issue_ci_staleness.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__update_pull_request_branch",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_update_pr_branch.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_merge_safety.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__create_branch",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_main_freshness.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/block_sensitive_reads.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_irreversible_bash.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_gh_cli.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git *)",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_unsigned_commit_bash.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git push*)",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_push_base.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git push*)",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_push_session_branch.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_commit_session_branch.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/check_commit_signing_ready.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git *)",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_session_branch_authz.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_session_branch_authz.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_session_base_freshness.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git commit*)",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_instruction_body_advisory.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git push*)",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_push_nonempty.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_branch_base.py verify"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/pr_body_close_keyword_gate.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_pr_body_retro_issue_link.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_coverage.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(issue_write|create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_title_policy.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_pr_body_required_sections.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_pr_template_shape.py"
          }
        ]
      },
      {
        "matcher": "mcp__codex_apps__github\\._(create_issue|create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_non_ascii.py"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_github_secrets.py"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_title_policy.py"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_angle_token_drop.py"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_issue_ci_staleness.py"
          }
        ]
      },
      {
        "matcher": "mcp__codex_apps__github\\._(create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_branch_base.py verify"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/pr_body_close_keyword_gate.py"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_pr_body_retro_issue_link.py"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_pr_body_required_sections.py"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_pr_template_shape.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__resolve_review_thread",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/preflight_resolve_review_thread.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_mcp_github_uncovered.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/plan_approval_gate.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(add_issue_comment|add_reply_to_pull_request_comment)",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_issue_close_comment.py --record"
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/post_pr_create_body_fix.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/session_resource_report.py checkpoint"
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/post_pr_create_ci_monitor.py"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/check_pr_mergeability.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__update_pull_request_branch",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/check_pr_mergeability.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git push*)",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/check_pr_mergeability.py git-push",
            "statusMessage": "Checking post-push PR mergeability"
          }
        ]
      },
      {
        "matcher": "mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/post_merge_retro_append.py"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/post_merge_new_session_prompt.py"
          }
        ]
      },
      {
        "matcher": "mcp__codex_apps__github\\._create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/session_resource_report.py checkpoint"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/post_pr_create_ci_monitor.py"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/check_pr_mergeability.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_decision_handoff_askuserquestion.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_handoff_retro_survey_askuserquestion.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/stop_new_session_handoff_prompt.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_cache_regime_advisor.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/gate_stop_pr_review_reply.py"
          }
        ]
      }

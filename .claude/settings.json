{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/tmp/claude-plans/**)",
      "Write(/tmp/claude-plans/**)",
      "MultiEdit(/tmp/claude-plans/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/install-uv.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/plan_language_context.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/check_hooks_path.py"
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
            "async": false
          }
        ],
        "_apm_source": "superpowers"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__github__(issue_write|add_issue_comment|create_pull_request|update_pull_request|add_reply_to_pull_request_comment|pull_request_review_write|add_comment_to_pending_review|sub_issue_write)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/preflight_non_ascii.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/preflight_branch_base.py verify"
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/pr_body_close_keyword_gate.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(issue_write|create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/preflight_title_policy.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/preflight_pr_body_required_sections.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/preflight_pr_template_shape.py"
          }
        ]
      },
      {
        "matcher": "mcp__codex_apps__github\\._(create_issue|create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/preflight_non_ascii.py"
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/preflight_title_policy.py"
          }
        ]
      },
      {
        "matcher": "mcp__codex_apps__github\\._(create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/preflight_branch_base.py verify"
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/pr_body_close_keyword_gate.py"
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/preflight_pr_body_required_sections.py"
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/preflight_pr_template_shape.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/plan_approval_gate.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/post_pr_create_ci_monitor.py"
          }
        ]
      },
      {
        "matcher": "mcp__codex_apps__github\\._create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/post_pr_create_ci_monitor.py"
          }
        ]
      }
    ],
    "sessionStart": [
      {
        "command": "./hooks/run-hook.cmd session-start",
        "_apm_source": "superpowers"
      }
    ]
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/install-uv.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/plan_language_context.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__github__(issue_write|add_issue_comment|create_pull_request|update_pull_request|add_reply_to_pull_request_comment|pull_request_review_write|add_comment_to_pending_review|sub_issue_write)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/preflight_non_ascii.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/pr_body_close_keyword_gate.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/preflight_pr_title_issue_ref.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/preflight_pr_body_required_sections.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/preflight_pr_template_shape.py"
          }
        ]
      }
    ]
  }
}

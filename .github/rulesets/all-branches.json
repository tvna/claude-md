{
  "name": "all-branches-no-force-push",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "~DEFAULT_BRANCH",
        "refs/heads/dependabot/*"
      ]
    }
  },
  "bypass_actors": [],
  "rules": [
    {"type": "non_fast_forward"}
  ]
}

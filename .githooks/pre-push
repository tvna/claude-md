#!/usr/bin/env bash
# Pre-push hook: run scripts/preflight_all.py before letting a push leave the
# working tree. Refs #493; closes the verification-drift gap where CI gates
# reject a push that no local gate ran first.
#
# Activation is opt-in (Git refuses to follow symlinks into a tracked hooks
# directory by default). Enable once per clone with:
#
#     git config core.hooksPath .githooks
#
# Escape hatch; when a push is genuinely urgent (e.g. a security rollback)
# the preflight loop can be bypassed by exporting PREFLIGHT_SKIP=1. This is an
# explicit, observable bypass so the next retro can see it in shell history.

set -euo pipefail

if [ "${PREFLIGHT_SKIP:-0}" = "1" ]; then
    echo "pre-push: PREFLIGHT_SKIP=1 set, skipping scripts/preflight_all.py." >&2
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
preflight="${repo_root}/scripts/preflight_all.py"

if [ ! -f "${preflight}" ]; then
    echo "pre-push: ${preflight} not found, skipping." >&2
    exit 0
fi

# preflight_branch_base.py is intentionally NOT invoked directly here: it is a
# cheap step inside preflight_all.py, which now runs the whole cheap tier
# (single-commit, branch-base, ruff, mypy, ...) before the heavy pytest suite
# and short-circuits the suite on any cheap failure. Calling it twice was pure
# redundant fetch overhead (issue #985, Codex CI-log analysis).
echo "pre-push: running scripts/preflight_all.py" >&2
python3 "${preflight}"

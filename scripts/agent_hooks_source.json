{
  "_comment": "Single source of truth for the per-agent hook configs. Generated files: .claude/settings.json, .codex/hooks.json, .devin/hooks.v1.json. Edit the command strings here in clean repo-relative form, then run python3 scripts/gen_agent_hooks.py to regenerate. The generator injects a working-directory-independence wrapper (cd to git toplevel) into every repo-script command so hooks run regardless of the session's CWD. Do NOT edit the generated files directly; .pre-commit-config.yaml enforces this with gen_agent_hooks.py --check. See docs/standards/agent-hooks-generation.md.",
  "targets": [
    {
      "agent": "claude",
      "path": ".claude/settings.json",
      "config": {
        "$schema": "https://json.schemastore.org/claude-code-settings.json",
        "permissions": {
          "allow": [
            "Edit(/tmp/claude-plans/**)",
            "Write(/tmp/claude-plans/**)",
            "MultiEdit(/tmp/claude-plans/**)"
          ]
        },
        "hooks": {
          "SessionStart": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "scripts/install-uv.sh"
                }
              ]
            },
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "scripts/install-rtk.sh"
                }
              ]
            },
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "scripts/install-apm.sh"
                }
              ]
            },
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "scripts/install-actionlint.sh"
                }
              ]
            },
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "scripts/install-waza.sh"
                }
              ]
            },
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "scripts/session_uv_local_pin.sh"
                }
              ]
            },
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "uv run python3 scripts/gen_mcp_json.py"
                }
              ]
            },
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/plan_language_context.py"
                }
              ]
            },
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/check_hooks_path.py"
                }
              ]
            },
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/check_session_branch.py"
                }
              ]
            },
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/check_pr_mergeability.py session-start"
                }
              ]
            },
            {
              "matcher": "startup|clear|compact",
              "hooks": [
                {
                  "type": "command",
                  "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
                  "async": false
                }
              ],
              "_apm_source": "superpowers"
            }
          ],
          "UserPromptSubmit": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/prompt_context7_gate.py"
                }
              ]
            }
          ],
          "PreToolUse": [
            {
              "matcher": "Read",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/block_sensitive_reads.py"
                }
              ]
            },
            {
              "matcher": "mcp__github__(issue_write|add_issue_comment|create_pull_request|update_pull_request|add_reply_to_pull_request_comment|pull_request_review_write|add_comment_to_pending_review|sub_issue_write|merge_pull_request)",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_non_ascii.py"
                }
              ]
            },
            {
              "matcher": "mcp__github__issue_write",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/issue_closure_fast_path.py"
                }
              ]
            },
            {
              "matcher": "mcp__github__issue_write",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/gate_issue_close_comment.py"
                }
              ]
            },
            {
              "matcher": "mcp__github__issue_write",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/gate_issue_classification_labels.py"
                }
              ]
            },
            {
              "matcher": "mcp__github__update_pull_request_branch",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/gate_update_pr_branch.py"
                }
              ]
            },
            {
              "matcher": "mcp__github__create_branch",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_main_freshness.py"
                }
              ]
            },
            {
              "matcher": "Bash",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/block_sensitive_reads.py"
                }
              ]
            },
            {
              "matcher": "Bash",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/gate_gh_cli.py"
                }
              ]
            },
            {
              "matcher": "Bash",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_push_base.py"
                }
              ]
            },
            {
              "matcher": "Bash",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_push_session_branch.py"
                }
              ]
            },
            {
              "matcher": "Bash",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_commit_session_branch.py"
                }
              ]
            },
            {
              "matcher": "Bash",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_push_nonempty.py"
                }
              ]
            },
            {
              "matcher": "mcp__github__(create_pull_request|update_pull_request)",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_branch_base.py verify"
                },
                {
                  "type": "command",
                  "command": "python3 scripts/pr_body_close_keyword_gate.py"
                }
              ]
            },
            {
              "matcher": "mcp__github__(create_pull_request|update_pull_request)",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_coverage.py"
                }
              ]
            },
            {
              "matcher": "mcp__github__(issue_write|create_pull_request|update_pull_request)",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_title_policy.py"
                }
              ]
            },
            {
              "matcher": "mcp__github__(create_pull_request|update_pull_request)",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_pr_body_required_sections.py"
                }
              ]
            },
            {
              "matcher": "mcp__github__(create_pull_request|update_pull_request)",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_pr_template_shape.py"
                }
              ]
            },
            {
              "matcher": "mcp__codex_apps__github\\._(create_issue|create_pull_request|update_pull_request)",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_non_ascii.py"
                },
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_title_policy.py"
                }
              ]
            },
            {
              "matcher": "mcp__codex_apps__github\\._(create_pull_request|update_pull_request)",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_branch_base.py verify"
                },
                {
                  "type": "command",
                  "command": "python3 scripts/pr_body_close_keyword_gate.py"
                },
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_pr_body_required_sections.py"
                },
                {
                  "type": "command",
                  "command": "python3 scripts/preflight_pr_template_shape.py"
                }
              ]
            },
            {
              "matcher": "mcp__github__",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/gate_mcp_github_uncovered.py"
                }
              ]
            }
          ],
          "PostToolUse": [
            {
              "matcher": "Write",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/plan_approval_gate.py"
                }
              ]
            },
            {
              "matcher": "mcp__github__(add_issue_comment|add_reply_to_pull_request_comment)",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 scripts/gate_issue_close_comment.py --record"

# OS/editor
.DS_Store
.idea/
.vscode/

# Python/local tooling
.venv/
__pycache__/
*.py[cod]

# Coverage gate artefacts (#277). pytest-cov writes .coverage, the XML
# report, and the JSON report under repo root; these are build outputs,
# not source. coverage.json is generated by --cov-report=json (#952).
.coverage
coverage.xml
coverage.json
htmlcov/
# JUnit XML for Codecov Test Analytics (#469). Generated by pytest's
# --junitxml flag in both lint-scripts-pytest and coverage workflows;
# build output, not source.
junit.xml

# APM dependencies/cache output
apm_modules/

# Host-unit DuckDB metrics store (#815). The per-host database is local
# measurement state, never committed; only metrics/duckdb/schema/**.sql is
# source. See docs/standards/host-unit-duckdb-metrics.md.
*.duckdb
*.duckdb.wal

# Claude local state
# .claude/ is broadly prohibited per docs/standards/repo-scope.md (#58).
# .claude/settings.local.json is the documented developer-local carve-out —
# it remains a contributor's local-only file, and the broader directory rule
# below transitively keeps it out of commits.
# .claude/settings.json is the narrow file-level carve-out from #109,
# permitted only to host deterministic lifecycle hooks.
.claude/*
!.claude/settings.json

# Agent-tool-specific config (prohibited per docs/standards/repo-scope.md, #58)
.cursor/
.cursorrules
.aider*
.continue/
# .codex/hooks.json is the narrow file-level carve-out from #604/#606,
# permitted only to host deterministic Codex lifecycle hooks.
.codex/*
!.codex/hooks.json
.github/copilot-instructions.md
.windsurfrules
.codeium/
# .mcp.json is the MCP client config generated locally by `apm install` from
# the `apm.yml` mcp declaration (the SoT). The committed mirror is prohibited,
# parallel to `.claude/skills/`; the server lives in apm.yml. See #58, #1067, #1063.
.mcp.json

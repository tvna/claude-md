# OS/editor
.DS_Store
.idea/
.vscode/

# Python/local tooling
.venv/
__pycache__/
*.py[cod]

# Coverage gate artefacts (#277). pytest-cov writes .coverage, the XML
# report, and the JSON report under repo root; these are build outputs,
# not source. coverage.json is generated by --cov-report=json (#952).
.coverage
coverage.xml
coverage.json
htmlcov/
# JUnit XML for Codecov Test Analytics (#469). Generated by pytest's
# --junitxml flag in both lint-scripts-pytest and coverage workflows;
# build output, not source.
junit.xml

# APM dependencies/cache output
apm_modules/

# Host-unit DuckDB metrics store (#815). The per-host database is local
# measurement state, never committed; only metrics/duckdb/schema/**.sql is
# source. See docs/standards/host-unit-duckdb-metrics.md.
*.duckdb
*.duckdb.wal

# Claude local state
# .claude/ is broadly prohibited per docs/standards/repo-scope.md (#58).
# .claude/settings.local.json is the documented developer-local carve-out —
# it remains a contributor's local-only file, and the broader directory rule
# below transitively keeps it out of commits.
# .claude/settings.json is the narrow file-level carve-out from #109,
# permitted only to host deterministic lifecycle hooks.
# .claude/commands/ is the narrow directory carve-out from #1572, permitted
# to host repo-owned, frequently-used workflow slash commands.
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/commands/**

# Agent-tool-specific config (prohibited per docs/standards/repo-scope.md, #58)
.cursor/
.cursorrules
.aider*
.continue/
# .codex/hooks.json is the narrow file-level carve-out from #604/#606,
# permitted only to host deterministic Codex lifecycle hooks.
.codex/*
!.codex/hooks.json
.github/copilot-instructions.md
.windsurfrules
.codeium/

# Rendered MCP client config (prohibited per docs/standards/repo-scope.md).
# .mcp.json is the Claude Code project-scope MCP file. It is a build artefact
# rendered from apm.yml by scripts/gen_mcp_json.py (wired into the SessionStart
# hook in .claude/settings.json), can carry per-client credentials in env
# blocks, and is never committed. See docs/runbooks/context7-mcp.md.
.mcp.json

# Secrets / credentials. .env-style files hold tokens and API keys; they are
# never committed. There is no .env.example carve-out because the repo ships
# no example env file (add one with an explicit `!.env.example` line if that
# changes). git is the canonical secret boundary, not .claudeignore
# (docs/standards/repo-scope.md).
.env
.env.*

# Flake files staged into the nix-warm-claude Feature at image-build time by
# .github/workflows/publish-devcontainer-images.yml (claude legs only). They are
# copies of the repo-root flake the Feature realises into the baked closure;
# they are generated per build and never committed so they cannot drift from the
# source flake. See .devcontainer/images/features/nix-warm-claude/install.sh and
# issue #1491.
.devcontainer/images/features/nix-warm-claude/flake.nix
.devcontainer/images/features/nix-warm-claude/flake.lock
.devcontainer/images/features/nix-warm-claude/pyproject.toml

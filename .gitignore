# OS/editor
.DS_Store
.idea/
.vscode/

# Python/local tooling
.venv/
__pycache__/
*.py[cod]

# APM dependencies/cache output
apm_modules/

# Claude local state
# .claude/ is broadly prohibited per docs/repo-scope.md (#58).
# .claude/settings.local.json is the documented developer-local carve-out —
# it remains a contributor's local-only file, and the broader directory rule
# below transitively keeps it out of commits.
# .claude/settings.json is the narrow file-level carve-out from #109,
# permitted only to host deterministic SessionStart provisioning hooks.
.claude/*
!.claude/settings.json

# Agent-tool-specific config (prohibited per docs/repo-scope.md, #58)
.cursor/
.cursorrules
.aider*
.continue/
.github/copilot-instructions.md
.windsurfrules
.codeium/

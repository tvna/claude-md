# OS/editor
.DS_Store
.idea/
.vscode/

# Python/local tooling
.venv/
__pycache__/
*.py[cod]

# Coverage gate artefacts (#277). pytest-cov writes .coverage and the XML
# report under repo root when verify-agents.yml's `Run script unit tests
# with coverage` step runs; these are build outputs, not source.
.coverage
coverage.xml
htmlcov/
# JUnit XML for Codecov Test Analytics (#469). Generated by pytest's
# --junitxml flag in both lint-scripts-pytest and coverage workflows;
# build output, not source.
junit.xml

# APM dependencies/cache output
apm_modules/

# Claude local state
# .claude/ is broadly prohibited per docs/standards/repo-scope.md (#58).
# .claude/settings.local.json is the documented developer-local carve-out —
# it remains a contributor's local-only file, and the broader directory rule
# below transitively keeps it out of commits.
# .claude/settings.json is the narrow file-level carve-out from #109,
# permitted only to host deterministic lifecycle hooks.
.claude/*
!.claude/settings.json

# Agent-tool-specific config (prohibited per docs/standards/repo-scope.md, #58)
.cursor/
.cursorrules
.aider*
.continue/
# .codex/hooks.json is the narrow file-level carve-out from #604/#606,
# permitted only to host deterministic Codex lifecycle hooks.
.codex/*
!.codex/hooks.json
.github/copilot-instructions.md
.windsurfrules
.codeium/

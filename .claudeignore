# Agent-tool-specific config (prohibited per docs/standards/repo-scope.md, #58)
# .claude/settings.json is the narrow file-level carve-out from #109
# (deterministic lifecycle hooks only).
# .claude/skills/ is the narrow directory carve-out from #1983: the APM-deployed,
# pinned Superpowers skills, committed for Claude Code on the Web parity with
# Devin/Codex (.agents/skills/, #728).
.claude/*
!.claude/settings.json
!.claude/skills/
.cursor/
.cursorrules
.aider*
.continue/
.codex/
.github/copilot-instructions.md
.windsurfrules
.codeium/

# Rendered MCP client config (mirror of .gitignore; see docs/standards/repo-scope.md).
# .mcp.json is rendered from apm.yml by scripts/gen_mcp_json.py and never committed.
.mcp.json

# Secrets / credentials (mirror of .gitignore). Courtesy mirror only --
# .gitignore is the canonical secret boundary.
.env
.env.*

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tvna/claude-md/.gitapex/loop-engineering-audit.schema.json",
  "title": "Loop-engineering achievement audit checklist",
  "description": "Shape-only schema for .gitapex/loop-engineering-audit.toml. scripts/audit_loop_engineering.py is the normative reporter (machine-checkable drift detection against the working tree); this schema only validates the gross TOML shape. Refs #2294, #2268, #2342.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "items"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source", "audit_umbrella", "last_reviewed"],
      "properties": {
        "schema_version": {"type": "integer"},
        "source": {"type": "string"},
        "audit_umbrella": {"type": "string"},
        "last_reviewed": {"type": "string"}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimension", "title", "status", "machine_checkable", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "dimension": {"type": "string"},
          "title": {"type": "string"},
          "status": {"type": "string"},
          "machine_checkable": {"type": "boolean"},
          "evidence": {"type": "string"},
          "check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {"type": "string"},
              "target": {"type": "string"},
              "glob": {"type": "string"},
              "pattern": {"type": "string"}
            }
          }
        }
      }
    }
  }
}

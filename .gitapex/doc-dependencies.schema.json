{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tvna/claude-md/.gitapex/doc-dependencies.schema.json",
  "title": "Typed document dependency graph",
  "description": "Shape-only schema for .gitapex/doc-dependencies.toml (the PR-governance co-change graph). Enum correctness (node/edge type, severity) and referential integrity (edge endpoints resolve to declared node ids) are enforced by scripts/doc_graph.py load_graph, the normative validator; this schema is a shape-only companion, mirroring the ssot.schema.json precedent. See docs/runbooks/doc-dependency-graph.md. Refs #1754, #2342.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "nodes", "edges"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "description"],
      "properties": {
        "schema_version": {"type": "integer"},
        "description": {"type": "string"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "type"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "type": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "type", "severity"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "type": {"type": "string"},
          "severity": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    }
  }
}

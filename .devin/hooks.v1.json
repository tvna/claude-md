        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/post_pr_create_ci_monitor.py",
            "statusMessage": "Starting PR CI monitor"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/ci_early_status_probe.py",
            "statusMessage": "Checking early CI status"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/check_pr_mergeability.py",
            "statusMessage": "Checking PR mergeability"
          }
        ]
      }
    ]
  }
}
